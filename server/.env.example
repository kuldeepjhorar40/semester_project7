# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017/grievance_db
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/grievance_db
MONGO_URI=mongodb://127.0.0.1:27017/grievance_db

# ---- Auth ----
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# ---- Gemini API ----
# Get a key at https://aistudio.google.com/apikey
# If left empty, the chatbot automatically falls back to a built-in keyword classifier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
